---
import { Image } from 'astro:assets';
import annettePortrait from '../../assets/img/Annette-Pearson-4.webp';
---

<section class="hero-section py-5">
  <div class="container-fluid">

    <div class="row align-items-center g-4 g-lg-5">

     <!-- Left Column: Elevated Card with Content -->
      <div class="col-12 col-lg-6 d-flex justify-content-end">
        <div class="ltyv-hero-card p-4 p-md-5">
          <h1 class="hero-headline lh-sm mb-3">
            Leadership wellbeing for ambitious women in education
          </h1>
          <p class="hero-authority mb-4">
            Gain confidence, clarity, and resilience in 90 days with personalized executive coaching designed specifically for you.
          </p>
          
          <div class="cta-buttons d-flex flex-column flex-sm-row gap-3">
            <a href="/individuals" class="btn btn-primary-hero flex-fill">
              For Individuals
            </a>
            <a href="/organisations" class="btn btn-secondary-hero flex-fill">
              For Organisations
            </a>
          </div>
        </div>
      </div>



     <!-- Right Column: Annette Pearson Portrait with Badge -->
      <div class="col-12 col-lg-6 d-flex justify-content-lg-start">
        <div class="hero-portrait-wrapper position-relative rounded-4 shadow-sm overflow-hidden">
          <Image
            src={annettePortrait}
            alt="Annette Pearson — Leadership Wellbeing Coach"
            width={450}
            class="portrait-image"
          />
          <!-- Frosted Glass Overlay Badge -->
          <div class="portrait-badge position-absolute bottom-0 start-0 m-3 p-3">
            <h2 class="badge-name">Annette Pearson</h2>
            <p class="badge-title">Executive & Leadership Coach</p>
          </div>
        </div>
      </div>

      
    </div>
  </div>
</section>
