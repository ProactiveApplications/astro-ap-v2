---
import { Image } from 'astro:assets';
import logoImg from '../assets/img/logo-small-2.webp';

const year = new Date().getFullYear();
---

<footer class="ns-footer">
  <div class="container">

    <div class="row g-5 py-5">

      <!-- Col 1: Logo + tagline -->
      <div class="col-lg-3 col-md-6">
        <Image
          src={logoImg}
          alt="Listening to Your Voice"
          width={160}
          height={60}
          format="webp"
          class="ns-footer-logo mb-3"
        />
        <p class="ns-footer-tagline">
          Leadership wellbeing coaching for ambitious women in education.
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div class="col-lg-2 col-md-6">
        <p class="ns-footer-heading">Navigate</p>
        <ul class="list-unstyled mb-0">
          <li class="mb-2"><a href="/new-site/">Home</a></li>
          <li class="mb-2"><a href="/new-site/individuals">Individuals</a></li>
          <li class="mb-2"><a href="/new-site/organisations">Organisations</a></li>
          <li class="mb-2"><span class="ns-footer-disabled">Blog (coming soon)</span></li>
          <li class="mb-2"><a href="/legals/">Legal Documents</a></li>
        </ul>
      </div>

      <!-- Col 3: Contact -->
      <div class="col-lg-4 col-md-6">
        <p class="ns-footer-heading">Contact</p>
        <p class="mb-2">
          <a href="mailto:annette.pearson@listeningtoyourvoice.co.uk">
            annette.pearson@listeningtoyourvoice.co.uk
          </a>
        </p>
        <address class="ns-footer-address">
          Icon Offices, Office 1732<br />
          321–323 High Road<br />
          Chadwell Heath, Essex RM6 6AX<br />
          United Kingdom
        </address>
      </div>

      <!-- Col 4: CTA -->
      <div class="col-lg-3 col-md-6">
        <p class="ns-footer-heading">Ready to start?</p>
        <p class="ns-footer-tagline mb-3">
          Book a free discovery call and take the first step toward leading with confidence.
        </p>
        <a
          href="https://calendly.com/annetteruthpearson/leadership-wellbeing-accelerator-consultation"
          class="btn-cta btn-cta-sm"
          target="_blank"
          rel="noopener"
        >Book a Call</a>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="ns-footer-bottom py-4">
      <div class="row align-items-center">
        <div class="col-md-7">
          <p class="mb-0">
            Listening to Your Voice Limited &mdash; Company No. 09496006, registered in England &amp; Wales.<br />
            Registered Office: 249 Cranbrook Road, Ilford, Essex, IG1 4TG.
          </p>
        </div>
        <div class="col-md-5 text-md-end mt-3 mt-md-0">
          <p class="mb-0">
            &copy; {year} Listening to Your Voice Limited.<br />
            Website by <a href="https://proactiveweb.design" target="_blank" rel="noopener">Proactive Web Design</a>.
          </p>
        </div>
      </div>
    </div>

  </div>
</footer>

<style>
  .ns-footer {
    background-color: var(--brand-purple);
    color: #fff;
  }

  .ns-footer-logo {
    opacity: 0.9;
    filter: brightness(0) invert(1);
  }

  .ns-footer a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .ns-footer a:hover {
    color: #fff;
  }

  .ns-footer-heading {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 1rem;
  }

  .ns-footer-tagline {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .ns-footer-address {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.875rem;
    line-height: 1.7;
    font-style: normal;
  }

  .ns-footer-disabled {
    color: rgba(255, 255, 255, 0.3);
    font-size: inherit;
  }

  .ns-footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.45);
  }

  .ns-footer-bottom a {
    color: rgba(255, 255, 255, 0.55);
  }

  .ns-footer-bottom a:hover {
    color: rgba(255, 255, 255, 0.85);
  }
</style>
