---
import MainLayout from './MainLayout.astro';
import InnerPageHeader from '../components/website/inner-page-header.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
}

const { title, subtitle, description } = Astro.props;
---

<MainLayout title={title} description={description}>
  <InnerPageHeader title={title} subtitle={subtitle} />

  <section class="blog-content">
    <div class="container">
      <div class="blog-content__inner">
        <slot />
      </div>
    </div>
  </section>
</MainLayout>
